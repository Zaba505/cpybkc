;; Appendix A.4's negative tests. The accepted sign nibbles are A through F;
;; 0 through 9 are digits and are not signs, so a field ending in one is a
;; field whose offsets have slipped or whose bytes were converted.
(encoding
  (charset ascii)
  (sign-convention ascii-zone-37)
  (byte-order big-endian)
  (float-format ieee-754))

(framing
  (recfm F)
  (lrecl 3))

(record PACKED
  (copybook "packed.cpy" PACKED-RECORD))

(discriminate PACKED single-record-type)

(sequence (* PACKED))
